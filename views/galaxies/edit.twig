<!-- views/galaxies/edit.twig -->
{% extends "layout.twig" %}

{% block title %}Edit {{ galaxy.name }} | Star Tracker{% endblock %}

{% block content %}
  <h2>Edit Galaxy</h2>
  <form action="/galaxies/{{ galaxy.id }}?_method=PUT" method="POST" enctype="multipart/form-data">
    <div>
      <label for="name">Name:</label>
      <input type="text" id="name" name="name" value="{{ galaxy.name }}" required>
    </div>
    <div>
      <label for="size">Size:</label>
      <input type="text" id="size" name="size" value="{{ galaxy.size }}">
    </div>
    <div>
      <label for="image">Upload New Image:</label>
      <input type="file" id="image" name="image">
    </div>
    <button type="submit">Update Galaxy</button>
  </form>
{% endblock %}